# ==============================================================================
# SahayakAI - Environment Configuration Template
# Copy this file to '.env' and adjust variables as needed.
# Do NOT commit actual secrets or '.env' files to version control.
# ==============================================================================

# --- Application Configuration ---
APP_NAME=SahayakAI
APP_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database Foundation ---
DATABASE_URL=sqlite:///./data/sahayakai.db

# --- AI Provider Configuration ---
# Options: gemini | demo (demo mode runs locally without external API access)
AI_PROVIDER=gemini

# General AI Settings
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=1000
AI_TEMPERATURE=0.2

# Google Gemini Configuration (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- CORS Settings ---
# Comma-separated list of allowed frontend origins (no '*' in production)
CORS_ORIGINS=http://localhost:5173,https://sahayakai1.vercel.app/

# --- Storage & Upload Limits ---
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# --- Document Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# --- Sentence Transformer & Embedding Settings (Step 6) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
# EMBEDDING_CACHE_DIR=./models/cache

# --- Vector Retrieval and RAG Settings (Step 7) ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=12000
RAG_MAX_QUESTION_CHARS=2000

# --- Chat and Study Assistant Settings (Step 8) ---
CHAT_MAX_MESSAGE_CHARS=4000
CHAT_HISTORY_MAX_MESSAGES=10
CHAT_MAX_HISTORY_CHARS=6000
CHAT_MAX_TITLE_CHARS=255


